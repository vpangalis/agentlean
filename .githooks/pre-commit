#!/bin/sh
# Tracked git hook — regenerates the progress view and CONTINUITY.md from the
# ONE FUNCTION, agent-improve/tools/control_board/progress.py (step 6.63).
#
# Activated per clone with:
#     git config core.hooksPath .githooks
#
# Fail-SOFT, and deliberately the opposite of the commit-msg guard: this hook
# WRITES, and a writing hook that breaks must never wedge a commit. The
# commit-msg guard is the enforcement point — rule 5 (CONTINUITY's block) and
# rule 10 (the board is a true picture of the tree) both fail CLOSED, so a
# page this hook failed to rebuild cannot land. Fail-soft writer, fail-closed
# checker.
#
# Two writers, in this order:
#   1. pre-commit-continuity.py — CONTINUITY.md's status block and the
#      procedure's step board, both from progress(). Stdlib only.
#   2. build_control_board.py --staged — docs/control-board.html, THE ONLY
#      PROGRESS VIEW (founder, 2026-09-25). It reads the code for its diagram,
#      so it runs on the project venv's python.
#
# docs/board.html IS NO LONGER WRITTEN (step 6.63). It was a second progress
# view; the founder ruled control-board.html the only one. build_board.py
# stays for its readers (markers, gaps, the build matrix), which the guard
# and the tests use.
#
# docs/test-results.json is staged with the page: every green on the board is
# "this test passed on this source", and the record is what says so.
CONTINUITY=".claude/hooks/pre-commit-continuity.py"
CONTROL="agent-improve/tools/control_board/build_control_board.py"

VENV=""
for CAND in agent-improve/.venv/Scripts/python.exe agent-improve/.venv/bin/python; do
    [ -x "$CAND" ] && VENV="$CAND" && break
done

for PY in python3 python py; do
    if command -v "$PY" >/dev/null 2>&1; then
        [ -f "$CONTINUITY" ] && "$PY" "$CONTINUITY"
        break
    fi
done

if [ -f "$CONTROL" ]; then
    if [ -n "$VENV" ] && "$VENV" "$CONTROL" agent-improve/docs/control-board.html --staged; then
        git add agent-improve/docs/control-board.html agent-improve/docs/test-results.json 2>/dev/null
    else
        echo "  [control-board] WARNING: control-board.html was NOT rebuilt" \
             "(no project venv, or the error above). The commit-msg guard's" \
             "rule 10 will refuse the commit while the page disagrees with the tree." >&2
    fi
fi

exit 0

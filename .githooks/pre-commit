#!/bin/sh
# Tracked git hook — regenerates CONTINUITY.md's status block, the feature
# ratchet and the one board page from the Define feature list and the recorded
# test run: agent-improve/tools/control_board/features.py (step 6.67).
#
# Activated per clone with:
#     git config core.hooksPath .githooks
#
# Fail-SOFT, and deliberately the opposite of the commit-msg guard: this hook
# WRITES, and a writing hook that breaks must never wedge a commit. The
# commit-msg guard is the enforcement point — rules 5 (CONTINUITY), 10 (the
# board) and 11 (landing and the ratchet) fail CLOSED.
#
# In this order: the commit's ONE full test run (skipped when only Markdown is
# staged); pre-commit-continuity.py (CONTINUITY's block and the ratchet);
# the section index; build_control_board.py (the board). The procedure and
# its step board are archived (6.67).
#
# docs/test-results.json is staged with the page: every pass on the board is
# "this test passed on this source", and the record is what says so.
CONTINUITY=".claude/hooks/pre-commit-continuity.py"
CONTROL="agent-improve/tools/control_board/build_control_board.py"

VENV=""
for CAND in agent-improve/.venv/Scripts/python.exe agent-improve/.venv/bin/python; do
    [ -x "$CAND" ] && VENV="$CAND" && break
done

# 6.65 — each writer times itself into .claude/logs/timing.jsonl (rule g).
TIMING=".claude/hooks/timing.py"
SYSPY=""
for PY in python3 python py; do
    command -v "$PY" >/dev/null 2>&1 && SYSPY="$PY" && break
done
t_log() {  # $1 = label, $2 = start seconds
    [ -n "$SYSPY" ] && [ -f "$TIMING" ] && "$SYSPY" -c "import sys,time; sys.path.insert(0,'.claude/hooks'); import timing; timing.append({'kind':'hook','hook':'pre-commit '+sys.argv[1],'seconds':round(time.time()-float(sys.argv[2]),1)})" "$1" "$2" 2>/dev/null
}

# 6.65 — THE ONE FULL TEST RUN OF A COMMIT, and it runs FIRST: the headline
# and the board below are built from its record, so they describe this
# commit's code rather than the last run's. Skipped only when the commit stages
# nothing but Markdown. Its verdict is written to .claude/logs/full-run.json
# with the INDEX TREE it was run for (at the end of this hook, after the
# generated files are staged); the commit-msg guard's rule 4 trusts it only
# for that exact tree, and otherwise runs the suite itself.
MARKER=".claude/logs/full-run.json"
rm -f "$MARKER"
# 6.67 — where this commit's timing starts; prepare-commit-msg sums from here
# into the commit's `Timing:` trailer, which the board reads from git log.
mkdir -p .claude/logs && date +%s > .claude/logs/pre-commit-start
RAN=""
# 6.67 — path-based (founder addendum, speed item 1): code, config, hooks,
# .json/.html/.yaml run the suite; documentation only runs the fast checks
# (rules 12 and 13). The generated outputs a previous attempt left staged do
# not count as code.
if [ -n "$VENV" ] && git diff --cached --name-only \
    | grep -vE 'agent-improve/docs/(control-board\.html|test-results\.json|features-ratchet\.json)$' \
    | grep -qv '\.md$'; then
    T0=$(date +%s)
    echo "  [tests] the full suite, in parallel — the commit's one run (rule 4 reads it)…" >&2
    OUT=$( cd agent-improve && AGENT_IMPROVE_FULL_RUN=1 "../$VENV" -m pytest backend/tests -q --no-header         -p no:cacheprovider -n auto 2>&1 )
    CODE=$?
    SUMMARY=$(printf '%s
' "$OUT" | tail -1)
    FAILED=$(printf '%s
' "$OUT" | grep -E '^(FAILED|ERROR) ' | head -25)
    echo "  [tests] $SUMMARY" >&2
    t_log "full test run" "$T0"
    RAN=1
fi

T0=$(date +%s)
if [ -n "$SYSPY" ] && [ -f "$CONTINUITY" ]; then
    "$SYSPY" "$CONTINUITY"
fi
t_log continuity "$T0"

# 6.66 — the section index (CLAUDE.md §22 b): every heading of ARCHITECTURE.md
# and the procedure with its line range, regenerated so it is never stale.
T0=$(date +%s)
if [ -n "$SYSPY" ] && [ -f ".claude/hooks/section_index.py" ]; then
    "$SYSPY" .claude/hooks/section_index.py && git add agent-improve/docs/section-index.md 2>/dev/null
fi
t_log section-index "$T0"

T0=$(date +%s)
if [ -f "$CONTROL" ]; then
    if [ -n "$VENV" ] && "$VENV" "$CONTROL" agent-improve/docs/control-board.html --staged; then
        git add agent-improve/docs/control-board.html agent-improve/docs/test-results.json 2>/dev/null
    else
        echo "  [control-board] WARNING: control-board.html was NOT rebuilt" \
             "(no project venv, or the error above). The commit-msg guard's" \
             "rule 10 will refuse the commit while the page disagrees with the tree." >&2
    fi
fi
t_log control-board "$T0"

if [ -n "$RAN" ] && [ -n "$SYSPY" ]; then
    mkdir -p .claude/logs
    TREE=$(git write-tree)
    "$SYSPY" -c "import json,sys; json.dump({'tree': sys.argv[1], 'exit': int(sys.argv[2]), 'summary': sys.argv[3], 'failed': [l for l in sys.argv[4].splitlines() if l]}, open(sys.argv[5], 'w', encoding='utf-8'))"         "$TREE" "$CODE" "$SUMMARY" "$FAILED" "$MARKER"
fi

exit 0

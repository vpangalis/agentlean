{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(git worktree list*)",
      "Bash(git add agent-improve/*)",
      "Bash(git add .claude/*)",
      "Bash(git commit -F *)",
      "Bash(git commit -m *)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(.venv/Scripts/python.exe -m pytest *)",
      "Bash(AGENT_IMPROVE_NO_RECORD=1 .venv/Scripts/python.exe -m pytest *)",
      "Bash(agent-improve/.venv/Scripts/python.exe -m pytest *)",
      "Bash(.venv/Scripts/python.exe -m scripts.*)",
      "Bash(.venv/Scripts/python.exe tools/*)",
      "Bash(python .claude/hooks/*)",
      "PowerShell(& agent-improve/scripts/walk_server.ps1 *)",
      "PowerShell(& .\\agent-improve\\scripts\\walk_server.ps1 *)"
    ],
    "ask": [
      "Bash(.venv/Scripts/python.exe -m scripts.live_slice*)",
      "Bash(.venv/Scripts/python.exe -m scripts.define_runthrough*)",
      "Bash(.venv/Scripts/python.exe -m scripts.hard_path_scenarios*)",
      "Bash(.venv/Scripts/python.exe -m scripts.define_evals*)",
      "Bash(.venv/Scripts/python.exe -m scripts.validation_repeat*)",
      "Bash(.venv/Scripts/python.exe -m scripts.howto_replay*)",
      "Bash(.venv/Scripts/python.exe -m scripts.live_approval_check*)",
      "Bash(.venv/Scripts/python.exe -m scripts.coaching_proof_656*)",
      "Bash(.venv/Scripts/python.exe -m scripts.move_proof_661*)",
      "Bash(.venv/Scripts/python.exe -m scripts.judge_replay*)",
      "Bash(.venv/Scripts/python.exe -m scripts.planner_repeatability*)",
      "Bash(.venv/Scripts/python.exe -m scripts.judge_offline_checks*)",
      "Bash(.venv/Scripts/python.exe -m scripts.ingest_knowledge*)",
      "Bash(.venv/Scripts/python.exe -m scripts.create_indexes*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git -C * push*)",
      "Bash(git reset --hard*)",
      "Bash(git -C * reset --hard*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git reset --hard*)",
      "Bash(*start.ps1*)",
      "PowerShell(*start.ps1*)",
      "Bash(rm -r /*)",
      "Bash(rm -rf /*)",
      "Bash(rm -r ~*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -r ..*)",
      "Bash(rm -rf ..*)",
      "Bash(rm -r C:*)",
      "Bash(rm -rf C:*)",
      "PowerShell(Remove-Item * -Recurse*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/agent-improve/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start-context.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/agent-improve/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/preflight-on-commit.py\"",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/agent-improve/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-use-drift-check.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/agent-improve/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/fact-ownership-guard.py\"",
            "timeout": 120
          }
        ]
      }
    ],
    "InstructionsLoaded": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/agent-improve/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/instructions-loaded-log.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/agent-improve/.venv/Scripts/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/drift-check.py\" --quiet",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
